{
  "version": "0.1.0",
  "commands": [
    {
      "command": "git commit",
      "module": "git",
      "use": "commit <文件>...",
      "summary": "只 add 给定的文件并提交，工作区和暂存区里别的改动不进这个提交；打印新提交的完整 SHA",
      "caller": "session",
      "next": "dyna git commit --repo <目录> -m <说明> <文件>...",
      "args": [
        {
          "name": "文件",
          "kind": "positional",
          "required": true,
          "variadic": true
        },
        {
          "name": "message",
          "kind": "flag",
          "required": false,
          "value": "stringArray",
          "repeatable": true,
          "description": "提交说明；可重复，每个 -m 一段（跟 git commit 一样，末尾的署名行单独一段）"
        },
        {
          "name": "repo",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "仓库目录（相当于 git -C <目录>）；不给就用当前目录"
        }
      ]
    },
    {
      "command": "git push",
      "module": "git",
      "use": "push [branch]",
      "summary": "把分支推到远端并记下它跟踪的远端分支；不给分支就推当前分支；不强推",
      "caller": "session",
      "next": "dyna git push --repo <目录>",
      "args": [
        {
          "name": "branch",
          "kind": "positional",
          "required": false
        },
        {
          "name": "remote",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "远端名"
        },
        {
          "name": "repo",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "仓库目录（相当于 git -C <目录>）；不给就用当前目录"
        }
      ]
    },
    {
      "command": "home adr new",
      "module": "home",
      "use": "new <name>",
      "summary": "打印下一份 ADR 的文件名：比现有最大编号大 1 的四位编号加名字，编号不复用",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "name",
          "kind": "positional",
          "required": true
        },
        {
          "name": "project",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "项目名（不带就取当前目录所在的项目）"
        }
      ]
    },
    {
      "command": "home commit",
      "module": "home",
      "use": "commit <message> <file>...",
      "summary": "只提交列出的文件到 home 的主分支再推送；docs 里有重名 slug 或死链就拒绝",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "message",
          "kind": "positional",
          "required": true
        },
        {
          "name": "file",
          "kind": "positional",
          "required": true,
          "variadic": true
        }
      ]
    },
    {
      "command": "home config apply",
      "module": "home",
      "use": "apply",
      "summary": "先备份 settings.json 和 CLAUDE.md，再做还没做的改动；都已做就什么都不写",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "only",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "只做这几项：1,2,3 或 plugin,memory,claude-md"
        }
      ]
    },
    {
      "command": "home config plan",
      "module": "home",
      "use": "plan",
      "summary": "列出三处用户级改动各自的改前、改后、是否已做；什么都不写",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "json",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "输出 JSON"
        },
        {
          "name": "only",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "只看这几项：1,2,3 或 plugin,memory,claude-md"
        }
      ]
    },
    {
      "command": "home glossary check",
      "module": "home",
      "use": "check [file]",
      "summary": "查 GLOSSARY.md 的格式；有问题退出 2。--hook：读 PostToolUse 事件，写到 GLOSSARY.md 才查，有问题退出 2 并在 stderr 回话",
      "caller": "hook",
      "next": "",
      "args": [
        {
          "name": "file",
          "kind": "positional",
          "required": false
        },
        {
          "name": "hook",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "从 stdin 读 PostToolUse 事件；有问题退出码 2、理由写到 stderr"
        },
        {
          "name": "json",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "输出 JSON"
        }
      ]
    },
    {
      "command": "home index",
      "module": "home",
      "use": "index",
      "summary": "按各份 frontmatter 重新生成 spec、adr、raw 三层的 index.md",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "layer",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "只生成一层：spec | adr | raw"
        },
        {
          "name": "project",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "项目名（不带就取当前目录所在的项目）"
        }
      ]
    },
    {
      "command": "home map",
      "module": "home",
      "use": "map",
      "summary": "开场注入当前项目的项目目录和项目地图（出任何岔子都什么也不打印）",
      "caller": "hook",
      "next": "",
      "args": []
    },
    {
      "command": "home memory check",
      "module": "home",
      "use": "check [dir]",
      "summary": "量记忆根索引：不超 140 行和 25,000 字节，链接都在，条目都进了索引；有问题退出 2",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "dir",
          "kind": "positional",
          "required": false
        }
      ]
    },
    {
      "command": "home where",
      "module": "home",
      "use": "where",
      "summary": "打印当前项目在 home 里的目录（JSON）；在 home 本身里要带 --project",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "project",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "项目名（在 home 目录里，或不在项目的仓库里时要带）"
        }
      ]
    },
    {
      "command": "issues backlog",
      "module": "issues",
      "use": "backlog <docs> [limit]",
      "summary": "JSON：没有 status:* 的 open issue，最老的在前；等人补而没人答的不列",
      "caller": "session",
      "next": "dyna issues show <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "limit",
          "kind": "positional",
          "required": false
        }
      ]
    },
    {
      "command": "issues block add",
      "module": "issues",
      "use": "add <docs> <n> <blocker>",
      "summary": "标：#n 被 #blocker 挡着",
      "caller": "session",
      "next": "dyna issues block list <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true
        },
        {
          "name": "blocker",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "issues block list",
      "module": "issues",
      "use": "list <docs> <n>",
      "summary": "列：JSON，挡着 #n 的 issue",
      "caller": "session",
      "next": "dyna issues show <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "issues block remove",
      "module": "issues",
      "use": "remove <docs> <n> <blocker>",
      "summary": "去：#n 不再被 #blocker 挡着",
      "caller": "session",
      "next": "dyna issues block list <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true
        },
        {
          "name": "blocker",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "issues body",
      "module": "issues",
      "use": "body <docs> <body-file>",
      "summary": "只核对正文的五节",
      "caller": "session",
      "next": "dyna issues new <docs> <title> <body-file>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "body-file",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "issues candidates",
      "module": "issues",
      "use": "candidates <docs> [limit]",
      "summary": "JSON：没被挡路的 todo（或 triage）issue，按「我的优先、再按优先级、再按等得久」排好",
      "caller": "session",
      "next": "dyna issues show <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "limit",
          "kind": "positional",
          "required": false
        },
        {
          "name": "state",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "todo 或 triage"
        }
      ]
    },
    {
      "command": "issues check",
      "module": "issues",
      "use": "check <docs> <state> <n>",
      "summary": "只核对翻状态的前提，不写任何东西（--from：不读 issue，n 可以是 Linear 的号）",
      "caller": "session",
      "next": "dyna issues show <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "state",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true
        },
        {
          "name": "comment",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "翻状态时的评论"
        },
        {
          "name": "from",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "issue 现在的状态（给了就不读 issue）"
        },
        {
          "name": "skip-design",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "没装 design 插件时跳过「设计已冻结」的核对"
        }
      ]
    },
    {
      "command": "issues guard",
      "module": "issues",
      "use": "guard [command]",
      "summary": "拦下手写的 gh issue edit 加或去 status:* label，提示改用 dyna issues set；别的 label 放行",
      "caller": "hook",
      "next": "dyna issues set <docs> <状态> <issue 号>",
      "args": [
        {
          "name": "command",
          "kind": "positional",
          "required": false
        },
        {
          "name": "hook",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "从 stdin 读 PreToolUse 事件；被拦时退出码 2、理由写到 stderr"
        }
      ]
    },
    {
      "command": "issues labels",
      "module": "issues",
      "use": "labels <docs>",
      "summary": "建出缺的 status / priority / kind / type label，列出多余的（--prune 删掉）",
      "caller": "session",
      "next": "dyna issues show <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "prune",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "删掉状态、优先级、类型、分类和保留清单之外的 label"
        }
      ]
    },
    {
      "command": "issues migrate",
      "module": "issues",
      "use": "migrate <docs>",
      "summary": "列出旧的中文状态 label 怎么换（--apply 才写）",
      "caller": "session",
      "next": "dyna issues labels <docs>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "apply",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "真的改"
        }
      ]
    },
    {
      "command": "issues new",
      "module": "issues",
      "use": "new <docs> <title> <body-file>",
      "summary": "开 issue：先核正文的五节和同标题的 open issue；打印新号",
      "caller": "session",
      "next": "dyna issues body <docs> <body-file>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "title",
          "kind": "positional",
          "required": true
        },
        {
          "name": "body-file",
          "kind": "positional",
          "required": true
        },
        {
          "name": "kind",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "bug / feature / improvement"
        },
        {
          "name": "priority",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "P0 / P1 / P2（开成 todo 必须带）"
        },
        {
          "name": "repo",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "开在别的仓库：owner/repo"
        },
        {
          "name": "state",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "backlog（默认）或 todo"
        },
        {
          "name": "type",
          "kind": "flag",
          "required": false,
          "value": "stringArray",
          "repeatable": true,
          "description": "分类，如 seo/blog，可重复"
        }
      ]
    },
    {
      "command": "issues note",
      "module": "issues",
      "use": "note <docs> <n> <body-file>",
      "summary": "在 #n 上评论，带 AI 前缀",
      "caller": "session",
      "next": "dyna issues show <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true
        },
        {
          "name": "body-file",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "issues priority",
      "module": "issues",
      "use": "priority <docs> <P0|P1|P2|none> <n>...",
      "summary": "换 issue 的 priority:* label（none：只去掉）",
      "caller": "session",
      "next": "dyna issues show <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "P0|P1|P2|none",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true,
          "variadic": true
        }
      ]
    },
    {
      "command": "issues queues",
      "module": "issues",
      "use": "queues <docs>",
      "summary": "JSON：这一刻调度该派什么、最多几个（读 ISSUE_TRACKER.md 的「调度」表，没有就用默认）、整张表和侧栏的分区",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "at",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "按这一刻（HH:MM）算，不给就用本机的钟"
        }
      ]
    },
    {
      "command": "issues read",
      "module": "issues",
      "use": "read <docs> <n>",
      "summary": "JSON：#n 的标题、状态、label、负责人、正文和全部评论（包 gh issue view）",
      "caller": "session",
      "next": "dyna issues show <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "issues reconcile",
      "module": "issues",
      "use": "reconcile <docs>",
      "summary": "PR 全合并 → done；PR 全 ready → in-review；旧 label、两个 status label 报问题",
      "caller": "session",
      "next": "dyna issues show <docs> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "issues set",
      "module": "issues",
      "use": "set <docs> <state> <n>...",
      "summary": "翻 issue 的状态：先逐个核对，再写；done / canceled 先关 issue 再去 label",
      "caller": "session",
      "next": "dyna issues check <docs> <状态> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "state",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true,
          "variadic": true
        },
        {
          "name": "comment",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "翻状态时的评论（翻 backlog 必须写清停在哪）"
        },
        {
          "name": "skip-design",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "没装 design 插件时跳过「设计已冻结」的核对"
        }
      ]
    },
    {
      "command": "issues show",
      "module": "issues",
      "use": "show <docs> <n>",
      "summary": "JSON：#n 的状态、标题、分类、PR（仓库、draft / ready / merged）、覆盖它的 spec、分支",
      "caller": "session",
      "next": "dyna issues check <docs> <状态> <n>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "issues type",
      "module": "issues",
      "use": "type <docs> <n> <parent[/child]>...",
      "summary": "把 #n 的 type:* label 设成项目分类里的给定值",
      "caller": "session",
      "next": "dyna issues labels <docs>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        },
        {
          "name": "n",
          "kind": "positional",
          "required": true
        },
        {
          "name": "parent[/child]",
          "kind": "positional",
          "required": true,
          "variadic": true
        }
      ]
    },
    {
      "command": "registry",
      "module": "registry",
      "use": "registry",
      "summary": "打印命令登记表：每条命令的名字、参数、说明、谁能调、出错时提示的下一条命令",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "json",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "输出 JSON（每版发布时存进 dyna/registry/<版本>.json）"
        }
      ]
    },
    {
      "command": "spec check",
      "module": "spec",
      "use": "check <docs>",
      "summary": "列出 docs/spec/ 下的 spec（JSON），报旧平铺布局、缺 spec 文件、还留着 status 行的问题",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "spec index",
      "module": "spec",
      "use": "index <docs>",
      "summary": "按 docs/spec/ 下的 spec 重写 docs/spec/index.md 的表，表外的字不动",
      "caller": "session",
      "next": "dyna spec check <docs>",
      "args": [
        {
          "name": "docs",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "spec landed",
      "module": "spec",
      "use": "landed <base-ref>",
      "summary": "列出集成分支上自与 <base-ref> 分叉以来已落地的工单（JSON：提交和工单名，旧的在前）",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "base-ref",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "spec skill-edit",
      "module": "spec",
      "use": "skill-edit <commit> <handback-file>",
      "summary": "核对交回文件有没有覆盖这个提交改到的 skill、agent 定义、skill 参考文件；不够时每条原因一行，退出 2",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "commit",
          "kind": "positional",
          "required": true
        },
        {
          "name": "handback-file",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "spec ticket-of",
      "module": "spec",
      "use": "ticket-of <commit>",
      "summary": "打印一个提交属于哪张工单；提交里没有 Ticket 行时不打印，退出 2",
      "caller": "session",
      "next": "",
      "args": [
        {
          "name": "commit",
          "kind": "positional",
          "required": true
        }
      ]
    },
    {
      "command": "version",
      "module": "version",
      "use": "version",
      "summary": "打印这个 dyna 的版本号",
      "caller": "session",
      "next": "",
      "args": []
    },
    {
      "command": "worktree add",
      "module": "worktree",
      "use": "add <名字>",
      "summary": "在主 checkout 旁边建 worktree（<上一级>/<仓库名>-worktrees/<名字>），打印它的路径；分支默认 issue/<名字>，已有就接上，路径上已经是这条分支的 worktree 就直接给回",
      "caller": "session",
      "next": "dyna worktree add <名字> --repo <主 checkout> --base <基准分支>",
      "args": [
        {
          "name": "名字",
          "kind": "positional",
          "required": true
        },
        {
          "name": "base",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "基准分支（DEVELOPMENT.md「分支」节写的）；新建分支或游离 worktree 时从 origin/<基准分支> 起，必须给"
        },
        {
          "name": "branch",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "分支名；不给就是 issue/<名字>（issue 已经有分支就写它）"
        },
        {
          "name": "detach",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "不建分支，游离在 origin/<基准分支> 上（triage 会话用）"
        },
        {
          "name": "path",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "worktree 的路径；不给就是 <主 checkout 的上一级>/<仓库名>-worktrees/<名字>"
        },
        {
          "name": "repo",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "主 checkout 的目录（建和删用同一个路径）；不给就用当前目录"
        }
      ]
    },
    {
      "command": "worktree guard",
      "module": "worktree",
      "use": "guard [command]",
      "summary": "拦下手写的 git worktree remove，提示改用 dyna worktree remove；别的 git worktree 子命令放行",
      "caller": "hook",
      "next": "dyna worktree remove <路径>",
      "args": [
        {
          "name": "command",
          "kind": "positional",
          "required": false
        },
        {
          "name": "hook",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "从 stdin 读 PreToolUse 事件；被拦时退出码 2、理由写到 stderr"
        }
      ]
    },
    {
      "command": "worktree list",
      "module": "worktree",
      "use": "list",
      "summary": "列出这个仓库的 worktree：路径、分支（游离的写 (detached)）、锁（locked），用制表符隔开",
      "caller": "session",
      "next": "dyna worktree list --repo <主 checkout>",
      "args": [
        {
          "name": "repo",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "主 checkout 的目录（建和删用同一个路径）；不给就用当前目录"
        }
      ]
    },
    {
      "command": "worktree remove",
      "module": "worktree",
      "use": "remove <路径>",
      "summary": "删 worktree：先解锁、再删 worktree、再删它的分支（--keep-branch 保留）；里面有没提交的改动就拒绝（--force 才删）",
      "caller": "session",
      "next": "dyna worktree list --repo <主 checkout>",
      "args": [
        {
          "name": "路径",
          "kind": "positional",
          "required": true
        },
        {
          "name": "force",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "里面有没提交的改动也删"
        },
        {
          "name": "keep-branch",
          "kind": "flag",
          "required": false,
          "value": "bool",
          "description": "不删分支（默认删，不论合并没合并：该不该删由调用方判断）"
        },
        {
          "name": "repo",
          "kind": "flag",
          "required": false,
          "value": "string",
          "description": "主 checkout 的目录（建和删用同一个路径）；不给就用当前目录；不给就从 worktree 自己找到它的主 checkout"
        }
      ]
    }
  ]
}
