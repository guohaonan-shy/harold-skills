#!/bin/sh
# dyna — the small launcher in the plugin's bin/ (Claude Code puts it on the session's PATH).
#
# It does one thing: hand the call to the installed command line, ~/.idea-loop/bin/dyna, together with the
# plugin's directory (IDEA_LOOP_PLUGIN_ROOT) and the command-line version range the plugin accepts
# (IDEA_LOOP_CLI_RANGE, read from the file `dyna-version` at the plugin's root). The binary checks its own
# version against that range and refuses to run outside it.
#
# `dyna self install [<version>]` and `dyna self upgrade` work without the binary: they download the package for
# this machine from the GitHub release, check its sha256 against the release's checksum file, and put the binary
# in ~/.idea-loop/bin/. install takes the lowest version the range accepts (the one the plugin was written
# against); upgrade takes the highest published one inside the range.
#
# Exit: the binary's own; 1 here when it is not installed or a download did not check out. With --hook among the
# arguments a missing binary is a line on stderr and exit 0: a hook must never stop a session.
#
# Test and development seams: HOME decides where the binary lives; IDEA_LOOP_DYNA_BIN runs that binary instead of the
# installed one (a locally built dyna, say); IDEA_LOOP_RELEASE_BASE and IDEA_LOOP_RELEASE_API replace the GitHub
# download and release-list URLs.

ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
RANGE_FILE="$ROOT/dyna-version"
REPO="guohaonan-shy/harold-skills"
BIN_DIR="${HOME}/.idea-loop/bin"
BIN="$BIN_DIR/dyna"
BASE="${IDEA_LOOP_RELEASE_BASE:-https://github.com/$REPO/releases/download}"
API="${IDEA_LOOP_RELEASE_API:-https://api.github.com/repos/$REPO/releases?per_page=100}"

say() { printf '%s\n' "$*" >&2; }

# the range, on one line, without comment lines
range() { grep -v '^[[:space:]]*#' "$RANGE_FILE" 2>/dev/null | tr -s ' \t\r\n' ' ' | sed 's/^ //; s/ $//'; }

# cmp A B -> -1, 0 or 1
cmp() { awk -v a="$1" -v b="$2" 'BEGIN { split(a, x, "."); split(b, y, "."); for (i = 1; i <= 3; i++) { if (x[i] + 0 < y[i] + 0) { print -1; exit } if (x[i] + 0 > y[i] + 0) { print 1; exit } } print 0 }'; }

# in_range VERSION -> exit 0 when every comparator of the range holds
in_range() {
  v="$1"
  for c in $(range); do
    case "$c" in
      '>='*) op=">="; w="${c#>=}" ;;
      '<='*) op="<="; w="${c#<=}" ;;
      '>'*) op=">"; w="${c#>}" ;;
      '<'*) op="<"; w="${c#<}" ;;
      '='*) op="="; w="${c#=}" ;;
      *) op="="; w="$c" ;;
    esac
    r=$(cmp "$v" "${w#v}")
    case "$op" in
      '>=') [ "$r" -ge 0 ] || return 1 ;;
      '<=') [ "$r" -le 0 ] || return 1 ;;
      '>') [ "$r" -gt 0 ] || return 1 ;;
      '<') [ "$r" -lt 0 ] || return 1 ;;
      '=') [ "$r" -eq 0 ] || return 1 ;;
    esac
  done
  return 0
}

# the floor of the range: the version after the first >= or =
lower_bound() {
  for c in $(range); do
    case "$c" in
      '>='*) echo "${c#>=}"; return 0 ;;
      '='[0-9]*) echo "${c#=}"; return 0 ;;
    esac
  done
  return 1
}

platform() {
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) say "这台机器的系统（$(uname -s)）没有发布的命令行包"; return 1 ;;
  esac
  case "$(uname -m)" in
    arm64 | aarch64) arch=arm64 ;;
    x86_64 | amd64) arch=amd64 ;;
    *) say "这台机器的架构（$(uname -m)）没有发布的命令行包"; return 1 ;;
  esac
  echo "${os}_${arch}"
}

sha256_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'; else sha256sum "$1" | awk '{print $1}'; fi
}

install_version() {
  ver="$1"
  plat=$(platform) || return 1
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/dyna-install.XXXXXX") || return 1
  trap 'rm -rf "$tmp"' EXIT
  archive="dyna_${ver}_${plat}.tar.gz"
  sums="dyna_${ver}_checksums.txt"
  url="$BASE/dyna-v${ver}"
  curl -fsSL "$url/$archive" -o "$tmp/$archive" || { say "下载 $url/$archive 失败"; return 1; }
  curl -fsSL "$url/$sums" -o "$tmp/$sums" || { say "下载 $url/$sums 失败"; return 1; }
  want=$(awk -v f="$archive" '$2 == f || $2 == "*" f { print $1 }' "$tmp/$sums" | head -n 1)
  [ -n "$want" ] || { say "校验和文件里没有 $archive，没装"; return 1; }
  got=$(sha256_of "$tmp/$archive")
  [ "$got" = "$want" ] || { say "校验和对不上（要 $want，下载的是 $got），没装"; return 1; }
  tar -xzf "$tmp/$archive" -C "$tmp" dyna || { say "解不开 $archive，没装"; return 1; }
  mkdir -p "$BIN_DIR" || return 1
  cp "$tmp/dyna" "$BIN.new" && chmod +x "$BIN.new" && mv -f "$BIN.new" "$BIN" || return 1
  say "已装 dyna $ver 到 $BIN"
}

latest_in_range() {
  list=$(curl -fsSL "$API") || { say "读不到发布列表 $API"; return 1; }
  best=""
  for v in $(printf '%s' "$list" | grep -o '"tag_name": *"dyna-v[0-9][0-9.]*"' | sed 's/.*dyna-v\([0-9.]*\)".*/\1/'); do
    in_range "$v" || continue
    if [ -z "$best" ] || [ "$(cmp "$v" "$best")" -gt 0 ]; then best="$v"; fi
  done
  [ -n "$best" ] || { say "发布列表里没有在 $(range) 之内的版本"; return 1; }
  echo "$best"
}

self_cmd() {
  case "${1:-}" in
    install)
      ver="${2:-}"
      [ -n "$ver" ] || ver=$(lower_bound) || { say "插件的 dyna-version 里没有下限"; return 1; }
      install_version "${ver#v}"
      ;;
    upgrade)
      ver=$(latest_in_range) || return 1
      install_version "$ver"
      ;;
    *)
      say "用法：dyna self install [<版本>] | dyna self upgrade"
      return 1
      ;;
  esac
}

if [ "${1:-}" = "self" ]; then
  shift
  self_cmd "$@"
  exit $?
fi

RUN="${IDEA_LOOP_DYNA_BIN:-$BIN}"
if [ ! -x "$RUN" ]; then
  say "命令行 dyna 还没装：跑 /idea-loop:setup 装命令行。"
  for a in "$@"; do
    [ "$a" = "--" ] && break
    [ "$a" = "--hook" ] && exit 0
  done
  exit 1
fi

IDEA_LOOP_PLUGIN_ROOT="$ROOT" IDEA_LOOP_CLI_RANGE="$(range)" exec "$RUN" "$@"
